<Window x:Class="GestiCoop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GestiCoop.UI.ViewModels"
        Title="GestiCoop - Gestion des stages coopératifs" Height="600" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:EtudiantsViewModel />
    </Window.DataContext>

    <DockPanel LastChildFill="True">

        <!-- MENU LATÉRAL  -->
        <Border DockPanel.Dock="Left" Width="220" Background="#3B5998" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="GestiCoop" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    <TextBlock Text="Stages coopératifs" FontSize="13" Foreground="#A0B2D8" Margin="0,0,0,40"/>

                    <TextBlock Text="PRINCIPAL" FontSize="11" Foreground="#A0B2D8" Margin="0,0,0,10" FontWeight="Bold"/>

                    <Button Content="Tableau de bord" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Margin="0,5,0,15" FontSize="14"/>
                    <Button Content="Offres de stage" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,15" FontSize="14"/>

                    <Button Content="Étudiants" Background="#283E6D" Foreground="White" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,10" Margin="-15,0,-15,15" FontSize="14" FontWeight="SemiBold"/>

                    <Button Content="Candidatures" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,15" FontSize="14"/>
                    <Button Content="Entreprises" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,15" FontSize="14"/>
                </StackPanel>

                <!-- MON NOM  -->
                <StackPanel Grid.Row="1" Margin="0,0,0,5">
                    <TextBlock Text="L. abderrahmane" FontSize="13" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Coordinateur" FontSize="11" Foreground="#A0B2D8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid Margin="20" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Ligne Titre + Bouton -->
                <RowDefinition Height="Auto"/>
                <!-- Ligne Recherche + Filtre -->
                <RowDefinition Height="*"/>
                <!-- Tableau -->
            </Grid.RowDefinitions>

            <!-- LIGNE 1 : Titre et bouton -->
            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Liste des étudiants" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="+ Ajouter un étudiant" Command="{Binding AjouterCommand}" Background="#E74C3C" Foreground="White" Padding="15,8" VerticalAlignment="Center" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- LIGNE 2 : Barre de recherche et Menu déroulant -->
            <DockPanel Grid.Row="1" Margin="0,0,0,15">
                <!-- Filtre à droite -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ComboBox Width="180" SelectedValue="{Binding ProgrammeFiltre}" SelectedValuePath="Content" Margin="0,0,10,0" Padding="5">
                        <ComboBoxItem Content="Tous les programmes" IsSelected="True"/>
                        <ComboBoxItem Content="Informatique"/>
                        <ComboBoxItem Content="Génie logiciel"/>
                        <ComboBoxItem Content="Cybersécurité"/>
                    </ComboBox>
                </StackPanel>

                <!-- Barre de recherche avec loupe -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,0,20,0">
                    <Grid>
                        <!-- Le TextBox principal avec un espace à gauche (Padding 25) pour ne pas écrire sur la loupe -->
                        <TextBox x:Name="txtRecherche" Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="25,2,2,2"/>

                        <!-- Le texte fantôme et la loupe qui disparaissent -->
                        <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False">
                            <Run Text="🔍" FontFamily="Segoe UI Emoji"/>
                            <Run Text=" Rechercher un étudiant..." />
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtRecherche}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- LE TABLEAU -->
            <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <ListView ItemsSource="{Binding Etudiants}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="NOM" DisplayMemberBinding="{Binding Nom}" Width="150"/>
                            <GridViewColumn Header="PRÉNOM" DisplayMemberBinding="{Binding Prenom}" Width="150"/>
                            <GridViewColumn Header="PROGRAMME" DisplayMemberBinding="{Binding Programme}" Width="180"/>
                            <GridViewColumn Header="COURRIEL" DisplayMemberBinding="{Binding Courriel}" Width="250"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

    </DockPanel>
</Window>