<Window x:Class="GestiCoop.UI.Views.AjouterEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GestiCoop.UI.ViewModels"
        Title="Ajouter un étudiant" Height="450" Width="400" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F8">

    <Window.DataContext>
        <vm:AjouterEtudiantVM />
    </Window.DataContext>

    <Border Background="White" Margin="15" CornerRadius="5" Padding="20">
        <StackPanel>

            <!-- NOM ET PRÉNOM -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="NOM *" FontWeight="Bold" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PRÉNOM *" FontWeight="Bold" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>
            </Grid>

            <!-- COURRIEL -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="COURRIEL *" FontWeight="Bold" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Courriel, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                <TextBlock Text="⚠ Adresse courriel invalide — ex. : prenom.nom@etud.lacite.ca" 
                           Foreground="#E74C3C" FontSize="11" Margin="0,5,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstCourrielInvalide}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- PROGRAMME -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="PROGRAMME *" FontWeight="Bold" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                <ComboBox SelectedValue="{Binding Programme, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Padding="5">
                    <ComboBoxItem Content="Informatique"/>
                    <ComboBoxItem Content="Génie logiciel"/>
                    <ComboBoxItem Content="Cybersécurité"/>
                </ComboBox>
            </StackPanel>

            <!-- NUMÉRO D'ÉTUDIANT -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="NUMÉRO D'ÉTUDIANT" FontWeight="Bold" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>

                <Grid>
                    <TextBox x:Name="txtNumero" Text="{Binding NumeroEtudiant, UpdateSourceTrigger=PropertyChanged}" Padding="5" />

                    <!-- Le texte "Optionnel" gris qui se cache quand on écrit -->
                    <TextBlock Text="Optionnel" Foreground="LightGray" Margin="7,6,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtNumero}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Text="Format : 7 chiffres (ex. : 2024001)" Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- BOUTONS -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Command="{Binding AnnulerCommand}" Width="80" Padding="5" Background="White" BorderBrush="LightGray"/>
                <Button Content="Enregistrer" Command="{Binding EnregistrerCommand}" Width="90" Padding="5" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="10,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>